<ContentDialog
    x:Class="PcmCdbEditor.App.CountryQuotaPreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Review country quota changes"
    CloseButtonText="Cancel"
    DefaultButton="None"
    FullSizeDesired="True"
    Opened="Dialog_Opened"
    Closed="Dialog_Closed"
    AutomationProperties.AutomationId="CountryQuotaReviewDialog"
    AutomationProperties.Name="Review country quota changes">

  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">1120</x:Double>

    <Style x:Key="QuotaReviewListItemStyle" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <DataTemplate x:Key="WideQuotaRowTemplate">
      <Grid
          Padding="8,10"
          ColumnSpacing="12"
          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
          BorderThickness="0,0,0,1">
        <Grid.Resources>
          <Style TargetType="TextBlock">
            <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
          </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.05*" />
          <ColumnDefinition Width="0.8*" />
          <ColumnDefinition Width="1.55*" />
          <ColumnDefinition Width="1.55*" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Top" Spacing="2">
          <TextBlock
              FontWeight="SemiBold"
              Text="{Binding CanonicalCode}"
              TextWrapping="Wrap" />
          <TextBlock
              FontSize="12"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Text="{Binding StoredCodeLabel}"
              TextWrapping="Wrap"
              Visibility="{Binding StoredCodeVisibility}" />
        </StackPanel>

        <TextBlock
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Text="{Binding UciPointsText}"
            TextWrapping="Wrap" />

        <StackPanel Grid.Column="2" VerticalAlignment="Top" Spacing="3">
          <TextBlock FontWeight="SemiBold" Text="{Binding WorldRankText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding WorldRoadText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding WorldTimeTrialText}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Column="3" VerticalAlignment="Top" Spacing="3">
          <TextBlock FontWeight="SemiBold" Text="{Binding EuropeanRankText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding EuropeanRoadText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding EuropeanTimeTrialText}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="CompactQuotaRowTemplate">
      <Grid
          Padding="8,12"
          RowSpacing="8"
          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
          BorderThickness="0,0,0,1">
        <Grid.Resources>
          <Style TargetType="TextBlock">
            <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
          </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="2">
            <TextBlock FontWeight="SemiBold" Text="{Binding CanonicalCode}" TextWrapping="Wrap" />
            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding StoredCodeLabel}"
                TextWrapping="Wrap"
                Visibility="{Binding StoredCodeVisibility}" />
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="UCI points" />
            <TextBlock HorizontalAlignment="Right" Text="{Binding UciPointsText}" />
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="3">
          <TextBlock FontWeight="SemiBold" Text="World Championship" />
          <TextBlock Text="{Binding WorldRankText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding WorldRoadText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding WorldTimeTrialText}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="3">
          <TextBlock FontWeight="SemiBold" Text="European Championship" />
          <TextBlock Text="{Binding EuropeanRankText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding EuropeanRoadText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding EuropeanTimeTrialText}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </ContentDialog.Resources>

  <Grid
      x:Name="ReviewLayout"
      MinWidth="320"
      MaxWidth="1040"
      MinHeight="420"
      MaxHeight="680"
      RowSpacing="10"
      SizeChanged="ReviewLayout_SizeChanged">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="ResponsiveStates">
        <VisualState x:Name="Compact">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="ReviewLayout.MinWidth" Value="320" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Medium">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="640" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="ReviewLayout.MinWidth" Value="560" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Large">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1008" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="ReviewLayout.MinWidth" Value="900" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Spacing="4">
      <TextBlock
          x:Name="SummaryText"
          TextWrapping="Wrap"
          AutomationProperties.AutomationId="CountryQuotaReviewSummary" />
      <TextBlock
          x:Name="ApplyScopeText"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          TextWrapping="Wrap"
          Text="Only calculated changes are applied. Changing this view or its sort never changes the update set." />
    </StackPanel>

    <Expander
        x:Name="CalculationExpander"
        Grid.Row="1"
        Header="How rankings and quotas are calculated"
        Expanding="CalculationExpander_Expanding"
        Collapsed="CalculationExpander_Collapsed"
        AutomationProperties.AutomationId="CountryQuotaCalculationDetails"
        AutomationProperties.Name="How rankings and quotas are calculated">
      <TextBlock
          Margin="0,8,0,4"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          TextWrapping="Wrap">
        Countries rank by UCI points from highest to lowest; ties use stored country code, then country ID. World Championship road/time-trial places: ranks 1–10 receive 8/2, ranks 11–19 receive 6/2, and ranks 20–25 receive 4/2. Europe ranks European countries separately: ranks 1–10 receive 8/2 and ranks 11–18 receive 6/2.
      </TextBlock>
    </Expander>

    <Grid
        x:Name="ReviewBody"
        Grid.Row="2"
        RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid RowSpacing="8" ColumnSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ComboBox
            x:Name="ScopeSelector"
            Grid.ColumnSpan="2"
            Header="Show"
            HorizontalAlignment="Stretch"
            SelectionChanged="ScopeSelector_SelectionChanged"
            AutomationProperties.AutomationId="CountryQuotaReviewScope"
            AutomationProperties.Name="Country quota review view"
            AutomationProperties.HelpText="Choose changed countries, World qualifiers, or European qualifiers." />

        <ComboBox
            x:Name="SortSelector"
            Grid.Row="1"
            Header="Sort by"
            HorizontalAlignment="Stretch"
            SelectionChanged="SortSelector_SelectionChanged"
            AutomationProperties.AutomationId="CountryQuotaReviewSort"
            AutomationProperties.Name="Sort country quota rows"
            AutomationProperties.HelpText="Choose the field used to order the visible country rows." />

        <Button
            x:Name="ReverseSortButton"
            Grid.Row="1"
            Grid.Column="1"
            MinWidth="44"
            Margin="0,24,0,0"
            HorizontalAlignment="Right"
            Click="ReverseSortButton_Click"
            AutomationProperties.AutomationId="ReverseCountryQuotaReviewSort"
            AutomationProperties.Name="Reverse country quota sort order"
            AutomationProperties.HelpText="Reverse the order of the visible country rows." />
      </Grid>

      <TextBlock
          x:Name="ResultsStatus"
          Grid.Row="1"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          TextWrapping="Wrap"
          AutomationProperties.AutomationId="CountryQuotaReviewStatus"
          AutomationProperties.LiveSetting="Polite" />

      <Grid
          x:Name="QuotaHeader"
          Grid.Row="2"
          Padding="8,6"
          ColumnSpacing="12"
          Background="{ThemeResource SubtleFillColorSecondaryBrush}"
          Visibility="Collapsed"
          AutomationProperties.AutomationId="CountryQuotaReviewHeaders">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.05*" />
          <ColumnDefinition Width="0.8*" />
          <ColumnDefinition Width="1.55*" />
          <ColumnDefinition Width="1.55*" />
        </Grid.ColumnDefinitions>
        <TextBlock FontWeight="SemiBold" Text="Country code" AutomationProperties.HeadingLevel="Level2" />
        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold" Text="UCI points" AutomationProperties.HeadingLevel="Level2" />
        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="World Championship" AutomationProperties.HeadingLevel="Level2" />
        <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="European Championship" AutomationProperties.HeadingLevel="Level2" />
      </Grid>

      <Grid Grid.Row="3">
        <ListView
            x:Name="QuotaResults"
            ItemContainerStyle="{StaticResource QuotaReviewListItemStyle}"
            ItemTemplate="{StaticResource CompactQuotaRowTemplate}"
            SelectionMode="None"
            ContainerContentChanging="QuotaResults_ContainerContentChanging"
            AutomationProperties.AutomationId="CountryQuotaReviewResults"
            AutomationProperties.Name="Country quota review results" />

        <StackPanel
            x:Name="EmptyState"
            Margin="16,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Spacing="4"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="CountryQuotaReviewEmptyState">
          <TextBlock
              x:Name="EmptyStateTitle"
              HorizontalAlignment="Center"
              FontWeight="SemiBold"
              Text="No countries in this view"
              TextWrapping="Wrap" />
          <TextBlock
              x:Name="EmptyStateMessage"
              HorizontalAlignment="Center"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</ContentDialog>
