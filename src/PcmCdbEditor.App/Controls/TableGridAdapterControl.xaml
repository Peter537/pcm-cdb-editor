<UserControl
    x:Class="PcmCdbEditor.App.Controls.TableGridAdapterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PcmCdbEditor.App.Controls">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <local:NativeTableView
        x:Name="GridControl"
        AutomationProperties.Name="Current table rows"
        AutomationProperties.HelpText="Use arrow keys to move between cells. Press F2 to edit. Enter opens a supported relationship picker or commits an inline edit. Click or tap a column header to make it the primary sort. A newly selected sort target starts descending. Repeating the same target toggles direction. Use Sort to edit or clear the full sort order."
        AutoGenerateColumns="False"
        BeginningEdit="GridControl_BeginningEdit"
        CanFilterColumns="False"
        CanSortColumns="True"
        CellEditEnded="GridControl_CellEditEnded"
        CellEditEnding="GridControl_CellEditEnding"
        SelectionMode="Multiple"
        SelectionChanged="GridControl_SelectionChanged"
        Sorting="GridControl_Sorting">
      <local:NativeTableView.ItemsPanel>
        <ItemsPanelTemplate>
          <ItemsStackPanel Orientation="Vertical" CacheLength="0" />
        </ItemsPanelTemplate>
      </local:NativeTableView.ItemsPanel>
    </local:NativeTableView>
  </Grid>
</UserControl>
