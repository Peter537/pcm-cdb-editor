<Application
    x:Class="PcmCdbEditor.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <muxc:XamlControlsResources />
      </ResourceDictionary.MergedDictionaries>
      <Color x:Key="BrandCobalt">#315FCC</Color>
      <Color x:Key="BrandTeal">#1A8F85</Color>
      <SolidColorBrush x:Key="BrandCobaltBrush" Color="{StaticResource BrandCobalt}" />
      <SolidColorBrush x:Key="BrandTealBrush" Color="{StaticResource BrandTeal}" />
      <SolidColorBrush x:Key="ShellDividerBrush" Color="{ThemeResource DividerStrokeColorDefault}" />
      <x:Double x:Key="CompactControlHeight">32</x:Double>

      <Style x:Key="ShellTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Small" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
