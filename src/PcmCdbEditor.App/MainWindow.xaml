<Window
    x:Class="PcmCdbEditor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PcmCdbEditor.App.Controls"
    xmlns:viewModels="using:PcmCdbEditor.App.ViewModels"
    Title="PCM CDB Editor">
  <Grid x:Name="WindowRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.Resources>
      <DataTemplate x:Key="WrappedListTextTemplate">
        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
      </DataTemplate>
    </Grid.Resources>
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="HistoryShortcut_Invoked" />
      <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="HistoryShortcut_Invoked" />
    </Grid.KeyboardAccelerators>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid
        x:Name="AppTitleBar"
        Grid.Row="0"
        Padding="12,0,148,0"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image Width="24" Height="24" Source="Assets/App.svg" Stretch="Uniform" />
      <TextBlock
          Grid.Column="1"
          Margin="10,0,0,0"
          VerticalAlignment="Center"
          FontFamily="Segoe UI Variable Text"
          FontSize="13"
          FontWeight="SemiBold"
          Text="PCM CDB Editor · 0.1.0 prerelease" />
      <TextBlock
          Grid.Column="2"
          VerticalAlignment="Center"
          AutomationProperties.LiveSetting="Polite"
          FontFamily="Segoe UI Variable Small"
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Text="{x:Bind ViewModel.DatabaseName, Mode=OneWay}" />
    </Grid>

    <NavigationView
        x:Name="Navigation"
        Grid.Row="1"
        AlwaysShowHeader="False"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        OpenPaneLength="216"
        CompactPaneLength="48"
        PaneDisplayMode="LeftCompact"
        SelectionChanged="Navigation_SelectionChanged"
        AutomationProperties.AutomationId="NavigationShell"
        AutomationProperties.Name="Primary navigation">
      <NavigationView.MenuItems>
        <NavigationViewItem
            x:Name="TablesNavigationItem"
            Content="Tables"
            Tag="tables"
            AutomationProperties.AutomationId="NavigationTables"
            AutomationProperties.Name="Tables">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="List" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem
            x:Name="MaintenanceNavigationItem"
            Content="Maintenance"
            Tag="maintenance"
            AutomationProperties.AutomationId="NavigationMaintenance"
            AutomationProperties.Name="Maintenance">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Repair" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem
            x:Name="CreateRiderNavigationItem"
            Content="Create Rider"
            Tag="create-rider"
            AutomationProperties.AutomationId="NavigationCreateRider"
            AutomationProperties.Name="Create Rider">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="AddFriend" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem
            x:Name="RecoveryNavigationItem"
            Content="Recovery"
            Tag="recovery"
            AutomationProperties.AutomationId="NavigationRecovery"
            AutomationProperties.Name="Recovery">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Refresh" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem
            Content="Changes"
            Tag="changes"
            AutomationProperties.AutomationId="NavigationChanges"
            AutomationProperties.Name="Changes">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="List" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <Grid x:Name="Workspace" SizeChanged="Workspace_SizeChanged">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" MinHeight="28" />
        </Grid.RowDefinitions>

        <CommandBar
            x:Name="WorkspaceCommandBar"
            Grid.Row="0"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="True"
            VerticalContentAlignment="Center"
            Background="Transparent"
            AutomationProperties.AutomationId="WorkspaceCommandBar"
            AutomationProperties.Name="Database commands">
          <CommandBar.Content>
            <Grid
                x:Name="WorkingCopyStatus"
                MaxWidth="220"
                Margin="12,0,8,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="Transparent"
                Visibility="Collapsed"
                ToolTipService.ToolTip="The original CDB remains untouched until you choose Save.">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <SymbolIcon
                  Symbol="Save"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  AutomationProperties.AccessibilityView="Raw" />
              <TextBlock
                  x:Name="WorkingCopyStatusText"
                  Grid.Column="1"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center"
                  FontFamily="Segoe UI Variable Text"
                  FontSize="13"
                  FontWeight="SemiBold"
                  Text="{x:Bind ViewModel.SaveStatus, Mode=OneWay}"
                  TextWrapping="NoWrap"
                  TextTrimming="CharacterEllipsis"
                  AutomationProperties.AutomationId="WorkingCopyReadyStatus"
                  AutomationProperties.Name="{x:Bind ViewModel.SaveStatus, Mode=OneWay}"
                  AutomationProperties.HelpText="The original CDB remains untouched until you choose Save."
                  AutomationProperties.LiveSetting="Polite" />
            </Grid>
          </CommandBar.Content>
          <AppBarButton x:Name="OpenButton" Icon="OpenFile" Label="Open" Click="Open_Click" AutomationProperties.AutomationId="OpenDatabaseCommand" AutomationProperties.Name="Open database" AutomationProperties.HelpText="Open a CDB file from a safe working copy. Shortcut Ctrl+O.">
            <AppBarButton.KeyboardAccelerators>
              <KeyboardAccelerator Key="O" Modifiers="Control" />
            </AppBarButton.KeyboardAccelerators>
          </AppBarButton>
          <AppBarButton x:Name="SaveButton" Icon="Save" Label="Save" Click="Save_Click" IsEnabled="{x:Bind ViewModel.IsDatabaseOpen, Mode=OneWay}" AutomationProperties.AutomationId="SaveDatabaseCommand" AutomationProperties.Name="Save database" AutomationProperties.HelpText="Convert and atomically replace the current destination. Shortcut Ctrl+S.">
            <AppBarButton.KeyboardAccelerators>
              <KeyboardAccelerator Key="S" Modifiers="Control" />
            </AppBarButton.KeyboardAccelerators>
          </AppBarButton>
          <AppBarButton x:Name="SaveAsButton" Icon="SaveLocal" Label="Save as" Click="SaveAs_Click" IsEnabled="{x:Bind ViewModel.IsDatabaseOpen, Mode=OneWay}" AutomationProperties.AutomationId="SaveDatabaseAsCommand" AutomationProperties.Name="Save database as" AutomationProperties.HelpText="Save the isolated working database to a different CDB destination." />
          <AppBarButton
              x:Name="CancelOperationButton"
              Icon="Cancel"
              Label="Cancel"
              Click="CancelOperation_Click"
              Visibility="Collapsed"
              AutomationProperties.AutomationId="CancelOperationCommand"
              AutomationProperties.Name="Cancel current operation"
              AutomationProperties.HelpText="Cancel the current open, save, table load, or maintenance operation." />
          <AppBarSeparator />
          <AppBarButton x:Name="UndoButton" Icon="Undo" Label="Undo" Click="Undo_Click" IsEnabled="False" AutomationProperties.AutomationId="UndoEditCommand" AutomationProperties.Name="Undo last edit" AutomationProperties.AcceleratorKey="Ctrl+Z" AutomationProperties.HelpText="Undo the last database edit. Shortcut Ctrl+Z." />
          <AppBarButton x:Name="RedoButton" Icon="Redo" Label="Redo" Click="Redo_Click" IsEnabled="False" AutomationProperties.AutomationId="RedoEditCommand" AutomationProperties.Name="Redo last undone edit" AutomationProperties.AcceleratorKey="Ctrl+Y" AutomationProperties.HelpText="Redo the last undone database edit. Shortcut Ctrl+Y." />
          <CommandBar.SecondaryCommands>
            <AppBarButton x:Name="RecentDatabasesButton" Label="Recent databases" Click="RecentDatabases_Click"
                AutomationProperties.AutomationId="ShowRecentDatabasesCommand" AutomationProperties.Name="Recent databases"
                AutomationProperties.HelpText="Choose a previously opened or saved CDB." />
            <AppBarSeparator />
            <AppBarToggleButton x:Name="RowInspectorToggle" Icon="View" Label="Hide row inspector" IsChecked="True" Click="RowInspectorToggle_Click" AutomationProperties.AutomationId="ToggleRowInspectorCommand" AutomationProperties.Name="Hide row inspector" />
            <AppBarButton x:Name="RowDetailsButton" Icon="View" Label="Row details" Click="RowDetails_Click" Visibility="Collapsed" IsEnabled="False" AutomationProperties.AutomationId="OpenRowDetailsCommand" AutomationProperties.Name="Open row details" />
            <AppBarButton x:Name="ResetColumnLayoutButton" Label="Reset column layout" Click="ResetColumnLayout_Click" IsEnabled="False" AutomationProperties.AutomationId="ResetColumnLayoutCommand" AutomationProperties.Name="Reset column layout" AutomationProperties.HelpText="Restore the current table's default column widths and order." />
            <AppBarButton x:Name="OverflowInsertRowButton" Icon="Add" Label="Insert row" Click="InsertRow_Click" IsEnabled="False" AutomationProperties.AutomationId="OverflowInsertTableRowCommand" AutomationProperties.Name="Insert row" AutomationProperties.HelpText="Create a new typed row in the current table." />
            <AppBarButton x:Name="OverflowEditRowButton" Icon="Edit" Label="Edit row" Click="EditRow_Click" IsEnabled="False" AutomationProperties.AutomationId="OverflowEditSelectedRowCommand" AutomationProperties.Name="Edit row" AutomationProperties.HelpText="Edit typed values in the one current row." />
            <AppBarButton x:Name="OverflowDeleteRowButton" Icon="Delete" Label="Delete row" Click="DeleteRow_Click" IsEnabled="False" AutomationProperties.AutomationId="OverflowDeleteSelectedRowCommand" AutomationProperties.Name="Delete row" AutomationProperties.HelpText="Review deletion of the one current row before confirmation." />
            <AppBarButton x:Name="OpenReferencedRowButton" Icon="Forward" Label="Open referenced row" Click="OpenReferencedRow_Click" IsEnabled="False" AutomationProperties.AutomationId="OpenReferencedRowCommand" AutomationProperties.Name="Open referenced row" AutomationProperties.HelpText="Open the row identified by the current relationship cell, or choose a relationship from the selected row." />
            <AppBarButton x:Name="ReturnToReferenceSourceButton" Icon="Back" Label="Return to source" Click="ReturnToReferenceSource_Click" IsEnabled="False" Visibility="Collapsed" AutomationProperties.AutomationId="ReturnToReferenceSourceCommand" AutomationProperties.Name="Return to source" AutomationProperties.HelpText="Restore the table, query, and position from before opening the reference." />
            <AppBarSeparator />
            <AppBarButton x:Name="DensityButton" Icon="Setting" Label="Density" Click="Density_Click" AutomationProperties.AutomationId="ChangeDensityCommand" AutomationProperties.Name="Change table density" AutomationProperties.HelpText="Choose compact or comfortable table density." />
            <AppBarButton x:Name="KeyboardShortcutsButton" Icon="Help" Label="Keyboard shortcuts" Click="KeyboardShortcuts_Click" AutomationProperties.AutomationId="ShowKeyboardShortcutsCommand" AutomationProperties.Name="Show keyboard shortcuts" />
          </CommandBar.SecondaryCommands>
        </CommandBar>

        <InfoBar
            x:Name="OperationInfo"
            Grid.Row="1"
            Margin="12,0,12,8"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational"
            AutomationProperties.AutomationId="OperationStatusMessage"
            AutomationProperties.Name="Operation status"
            AutomationProperties.LiveSetting="Polite" />

        <Grid x:Name="ContentHost" Grid.Row="2">
          <Grid x:Name="TablesView">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TableSidebarColumn" Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="InspectorColumn" Width="300" />
          </Grid.ColumnDefinitions>

          <Border
              Grid.Column="0"
              Padding="12"
              BorderBrush="{StaticResource ShellDividerBrush}"
              BorderThickness="0,0,1,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Tables" />
              <AutoSuggestBox
                  x:Name="TableSearchBox"
                  Grid.Row="1"
                  Margin="0,8,0,8"
                  Height="32"
                  QueryIcon="Find"
                  PlaceholderText="Find a table"
                  TextChanged="TableSearchBox_TextChanged"
                  AutomationProperties.AutomationId="TableCatalogSearch"
                  AutomationProperties.Name="Find a table" />
              <Grid Grid.Row="2">
                <ListView
                    x:Name="TablesList"
                    ItemsSource="{x:Bind ViewModel.Tables, Mode=OneWay}"
                    SelectionChanged="TablesList_SelectionChanged"
                    SelectionMode="Single"
                    AutomationProperties.AutomationId="TableCatalogList"
                    AutomationProperties.Name="Database tables">
                  <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:TableListItem">
                      <Grid Padding="2,5" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind KindLabel}" />
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <StackPanel
                    x:Name="NoTablesState"
                    VerticalAlignment="Top"
                    Margin="4,8,4,0"
                    Spacing="4"
                    AutomationProperties.AutomationId="NoTablesState"
                    AutomationProperties.Name="No tables loaded">
                  <TextBlock x:Name="NoTablesTitle" Text="No tables loaded" />
                  <TextBlock
                      x:Name="NoTablesDescription"
                      FontSize="12"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Text="Open a CDB file first."
                      TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <Grid Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TabView
                x:Name="TableTabs"
                Grid.Row="0"
                Height="42"
                IsAddTabButtonVisible="False"
                SelectionChanged="TableTabs_SelectionChanged"
                TabCloseRequested="TableTabs_TabCloseRequested"
                AutomationProperties.AutomationId="OpenTableTabs"
                AutomationProperties.Name="Open table tabs" />
            <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="8" RowSpacing="6">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <AutoSuggestBox
                  x:Name="CurrentTableSearchBox"
                  Height="32"
                  QueryIcon="Find"
                  PlaceholderText="Search stored values and related names"
                  ToolTipService.ToolTip="Searches literal text in stored values and available related names. Digits are matched as text."
                  TextChanged="CurrentTableSearchBox_TextChanged"
                  AutomationProperties.AutomationId="CurrentTableSearch"
                  AutomationProperties.Name="Search the current table"
                  AutomationProperties.HelpText="Searches literal text in stored values and available related names. Digits are matched as text." />
              <StackPanel x:Name="TableQueryButtons" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button x:Name="FiltersButton" Height="32" Content="Filters" Click="Filters_Click" AutomationProperties.AutomationId="ConfigureTableFiltersCommand" AutomationProperties.Name="Filters" AutomationProperties.HelpText="Build quick rules and numbered advanced filter rules for the current table." />
                <Button x:Name="SortButton" Height="32" Content="Sort" Click="Sort_Click" AutomationProperties.AutomationId="ConfigureTableSortCommand" AutomationProperties.Name="Sort" AutomationProperties.HelpText="Edit or clear the ordered multi-column sort. Click or tap a column header to make it priority 1." />
              </StackPanel>
              <ComboBox x:Name="PageSizeBox" Grid.Column="2" MinWidth="126" Height="32" SelectionChanged="PageSizeBox_SelectionChanged" AutomationProperties.AutomationId="TablePageSize" AutomationProperties.Name="Rows to show" AutomationProperties.HelpText="Choose 100, 250, or 500 rows per page, or load all matching rows for the current table. Loading all rows may require substantial time and memory.">
                <ComboBoxItem Content="100 rows" />
                <ComboBoxItem Content="250 rows" />
                <ComboBoxItem Content="500 rows" />
                <ComboBoxItem Content="All rows (slower)" />
              </ComboBox>
              <StackPanel x:Name="TablePagingButtons" Grid.Column="3" Orientation="Horizontal" Spacing="4">
                <Button x:Name="PreviousPageButton" Width="34" Height="32" Click="PreviousPage_Click" IsEnabled="False" ToolTipService.ToolTip="Previous page" AutomationProperties.AutomationId="PreviousTablePageCommand" AutomationProperties.Name="Previous page" AutomationProperties.HelpText="Show the previous page of rows in the current table.">
                  <SymbolIcon Symbol="Previous" />
                </Button>
                <Button x:Name="NextPageButton" Width="34" Height="32" Click="NextPage_Click" IsEnabled="False" ToolTipService.ToolTip="Next page" AutomationProperties.AutomationId="NextTablePageCommand" AutomationProperties.Name="Next page" AutomationProperties.HelpText="Show the next page of rows in the current table.">
                  <SymbolIcon Symbol="Next" />
                </Button>
              </StackPanel>
              <Grid Grid.Row="2" Grid.ColumnSpan="4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ActiveTableQueryText" Text="No table selected" VerticalAlignment="Center"
                    MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                    AutomationProperties.AutomationId="ActiveTableQuerySummary" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                  <Button x:Name="ResetTableQueryButton" Content="Reset query" Click="ResetTableQuery_Click" IsEnabled="False"
                      AutomationProperties.AutomationId="ResetTableQueryCommand" AutomationProperties.Name="Reset query"
                      AutomationProperties.HelpText="Clear search, filters, and sort and return to the first page." />
                  <Button x:Name="RefreshTableButton" Content="Refresh" Click="RefreshTable_Click" IsEnabled="False"
                      AutomationProperties.AutomationId="RefreshTableCommand" AutomationProperties.Name="Refresh current table"
                      AutomationProperties.HelpText="Reload the current query from the working database." />
                </StackPanel>
              </Grid>
            </Grid>
            <Grid Grid.Row="2">
              <controls:TableGridAdapterControl
                  x:Name="TableGrid"
                  Opacity="0"
                  IsEnabled="False"
                  IsHitTestVisible="False"
                  AutomationProperties.AutomationId="CurrentTableGrid"
                  AutomationProperties.Name="Current table data"
                  AutomationProperties.AccessibilityView="Raw" />
              <StackPanel
                  x:Name="TableLoadingState"
                  Width="420"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="10"
                  Visibility="Collapsed"
                  AutomationProperties.AutomationId="TableLoadingState"
                  AutomationProperties.Name="Table loading"
                  AutomationProperties.HelpText="The requested table is loading. Cancel returns to the previous completed table.">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="28"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                    Glyph="&#xE895;"
                    AutomationProperties.AccessibilityView="Raw" />
                <TextBlock
                    x:Name="TableLoadingTitle"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SectionTitleStyle}"
                    Text="Loading table…"
                    AutomationProperties.AutomationId="TableLoadingAnnouncement"
                    AutomationProperties.LiveSetting="Polite" />
                <TextBlock
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="The previous completed table remains available if you cancel." />
              </StackPanel>
              <StackPanel
                  x:Name="EmptyState"
                  Width="420"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="12"
                  AutomationProperties.AutomationId="NoDatabaseOpenState"
                  AutomationProperties.Name="No database open">
                <Image Width="72" Height="72" Source="Assets/App.svg" Stretch="Uniform" />
                <TextBlock
                    x:Name="EmptyStateTitle"
                    HorizontalAlignment="Center"
                    Style="{StaticResource ShellTitleStyle}"
                    Text="Open a CDB file" />
                <TextBlock
                    x:Name="EmptyStateDescription"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="The original stays untouched while you inspect and edit an isolated working copy." />
                <Button
                    x:Name="EmptyStateOpenButton"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Open_Click"
                    Content="Choose a CDB file"
                    AutomationProperties.AutomationId="EmptyStateOpenDatabaseCommand"
                    AutomationProperties.Name="Choose a CDB file"
                    AutomationProperties.HelpText="Open a CDB file in an isolated working session." />
                <Button x:Name="EmptyStateRecentDatabasesButton" HorizontalAlignment="Center" Content="Recent databases"
                    Click="RecentDatabases_Click" AutomationProperties.AutomationId="EmptyStateRecentDatabasesCommand"
                    AutomationProperties.Name="Recent databases" AutomationProperties.HelpText="Choose a previously opened or saved CDB." />
                <TextBlock
                    x:Name="EmptyStateReleaseLabel"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="Unreleased 0.1.0 · Unsigned prerelease" />
              </StackPanel>
              <FontIcon
                  x:Name="BusyIndicator"
                  Width="36"
                  Height="36"
                  FontSize="28"
                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                  Glyph="&#xE895;"
                  Visibility="Collapsed"
                  AutomationProperties.AutomationId="DatabaseOperationBusyState"
                  AutomationProperties.Name="Database operation in progress" />
            </Grid>
          </Grid>

          <Border
              x:Name="Inspector"
              Grid.Column="2"
              Padding="16,12"
              BorderBrush="{StaticResource ShellDividerBrush}"
              BorderThickness="1,0,0,0">
            <ScrollViewer>
              <StackPanel Spacing="12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Row inspector" />
                  <Button x:Name="CloseInspectorButton" Grid.Column="1" Width="32" Height="32" Click="CloseInspector_Click" ToolTipService.ToolTip="Close inspector" AutomationProperties.AutomationId="CloseRowInspectorCommand" AutomationProperties.Name="Close row inspector">
                    <SymbolIcon Symbol="Cancel" />
                  </Button>
                </Grid>
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Select a row to inspect typed values. BLOB values are shown as read-only metadata." />
                <Border Height="1" Background="{StaticResource ShellDividerBrush}" />
                <TextBlock x:Name="InspectorHeading" FontWeight="SemiBold" Text="No current row" TextWrapping="Wrap" AutomationProperties.AutomationId="RowInspectorHeading" />
                <TextBlock x:Name="InspectorSelection" TextWrapping="Wrap" />
                <StackPanel x:Name="RowActions" Orientation="Horizontal" Spacing="8">
                  <Button x:Name="EditRowButton" Content="Edit row" Click="EditRow_Click" IsEnabled="False" AutomationProperties.AutomationId="EditSelectedRowCommand" AutomationProperties.Name="Edit row" AutomationProperties.HelpText="Edit typed values in the one current row." />
                  <Button x:Name="DeleteRowButton" Content="Delete row" Click="DeleteRow_Click" IsEnabled="False" AutomationProperties.AutomationId="DeleteSelectedRowCommand" AutomationProperties.Name="Delete row" AutomationProperties.HelpText="Review deletion of the one current row before confirmation." />
                  <Button x:Name="InsertRowButton" Content="Insert row" Click="InsertRow_Click" IsEnabled="False" AutomationProperties.AutomationId="InsertTableRowCommand" AutomationProperties.Name="Insert row" AutomationProperties.HelpText="Create a new typed row in the current table." />
                </StackPanel>
                <ListView x:Name="InspectorValues" SelectionMode="None" AutomationProperties.AutomationId="RowInspectorValues" AutomationProperties.Name="Current row values and storage classes">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,8" Spacing="2">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding ColumnName}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{Binding DisplayValue}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                      </StackPanel>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </StackPanel>
            </ScrollViewer>
          </Border>
          </Grid>

          <ScrollViewer x:Name="MaintenanceView" Visibility="Collapsed">
            <StackPanel MaxWidth="880" Margin="32,20" HorizontalAlignment="Left" Spacing="16">
              <TextBlock Style="{StaticResource ShellTitleStyle}" Text="Maintenance" />
              <TextBlock
                  MaxWidth="720"
                  TextWrapping="Wrap"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Text="Each tool checks the working database and previews any changes. Select Apply to confirm a change." />
              <Border Padding="16" CornerRadius="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <StackPanel Spacing="10">
                  <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Rider recovery preset" />
                  <TextBlock TextWrapping="Wrap" Text="Set Fit 99, Injury 0, Injury days 0, Physical fatigue 0, Freshness 100, and Preparation 99 for the chosen riders with existing fitness rows." />
                  <StackPanel Orientation="Horizontal" Spacing="20">
                    <RadioButton
                        x:Name="RecoveryIdsModeRadioButton"
                        Content="Rider IDs"
                        GroupName="RecoveryTargetMode"
                        IsChecked="True"
                        Checked="RecoveryTargetMode_Changed"
                        AutomationProperties.AutomationId="RiderRecoveryIdsMode"
                        AutomationProperties.Name="Recover riders by ID" />
                    <RadioButton
                        x:Name="RecoveryTeamModeRadioButton"
                        Content="Entire team"
                        GroupName="RecoveryTargetMode"
                        Checked="RecoveryTargetMode_Changed"
                        AutomationProperties.AutomationId="RiderRecoveryTeamMode"
                        AutomationProperties.Name="Recover an entire team" />
                  </StackPanel>
                  <TextBox
                      x:Name="RiderIdsTextBox"
                      Header="Rider IDs"
                      PlaceholderText="For example: 42, 77; 103"
                      AutomationProperties.AutomationId="RiderRecoveryIds"
                      AutomationProperties.Name="Rider IDs"
                      AutomationProperties.HelpText="Enter positive rider IDs separated by commas, semicolons, spaces, or line breaks." />
                  <Button
                      x:Name="UseSelectedRiderRowsButton"
                      HorizontalAlignment="Left"
                      Content="Use selected rows"
                      Click="UseSelectedRiderRows_Click"
                      IsEnabled="False"
                      AutomationProperties.AutomationId="UseSelectedRiderRowsCommand"
                      AutomationProperties.Name="Use selected rows for rider recovery"
                      AutomationProperties.HelpText="Copy cyclist IDs from the checked table rows into the rider-ID field." />
                  <ComboBox
                      x:Name="RiderRecoveryTeamComboBox"
                      Header="Team"
                      PlaceholderText="Loading teams…"
                      IsEnabled="False"
                      HorizontalAlignment="Stretch"
                      AutomationProperties.AutomationId="RiderRecoveryTeam"
                      AutomationProperties.Name="Team for rider recovery"
                      AutomationProperties.HelpText="Choose a team to resolve its current DYN_cyclist roster during preview." />
                  <TextBlock
                      x:Name="RiderRecoveryTeamStatusText"
                      Text="Team choices load from the working database. Rider IDs remain available without team tables."
                      TextWrapping="Wrap"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      AutomationProperties.LiveSetting="Polite"
                      AutomationProperties.AutomationId="RiderRecoveryTeamStatus" />
                  <Button
                      x:Name="PreviewRiderRecoveryButton"
                      HorizontalAlignment="Left"
                      Content="Check and preview"
                      Click="PreviewRiderRecovery_Click"
                      AutomationProperties.AutomationId="PreviewRiderRecoveryCommand"
                      AutomationProperties.Name="Check and preview rider recovery"
                      AutomationProperties.HelpText="Check rider recovery requirements and preview changes without modifying the database." />
                </StackPanel>
              </Border>
              <Border Padding="16" CornerRadius="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <StackPanel Spacing="10">
                  <TextBlock Style="{StaticResource SectionTitleStyle}" Text="January 1 season-stage repair" />
                  <TextBlock TextWrapping="Wrap" Text="Preview the January 1 season-stage repair and the number of rows it will delete before applying it." />
                  <Button
                      x:Name="PreviewJanuaryRepairButton"
                      HorizontalAlignment="Left"
                      Content="Check and preview"
                      Click="PreviewJanuaryRepair_Click"
                      AutomationProperties.AutomationId="PreviewJanuaryRepairCommand"
                      AutomationProperties.Name="Check and preview January 1 season-stage repair"
                      AutomationProperties.HelpText="Check January 1 repair requirements and preview affected rows without modifying the database." />
                </StackPanel>
              </Border>
              <Border Padding="16" CornerRadius="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <StackPanel Spacing="10">
                  <TextBlock Style="{StaticResource SectionTitleStyle}" Text="World and European country quotas" />
                  <TextBlock TextWrapping="Wrap" Text="Preview the combined World Championship and European Championship quota update, including canonical country codes and ranks." />
                  <Button
                      x:Name="PreviewCountryQuotasButton"
                      HorizontalAlignment="Left"
                      Content="Check and preview"
                      Click="PreviewCountryQuotas_Click"
                      AutomationProperties.AutomationId="PreviewCountryQuotasCommand"
                      AutomationProperties.Name="Check and preview World and European country quotas"
                      AutomationProperties.HelpText="Check championship quota requirements and preview all changes without modifying the database." />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <ContentControl x:Name="RiderDraftInputHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <Grid x:Name="RiderCreationView" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="32,20,32,12" Spacing="6">
              <TextBlock Style="{StaticResource ShellTitleStyle}" Text="Create Rider" />
              <TextBlock
                  MaxWidth="760"
                  HorizontalAlignment="Left"
                  TextWrapping="Wrap"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Text="Create one clean rider and contract. The database is unchanged until you review and confirm both rows." />
            </StackPanel>

            <ScrollViewer
                x:Name="RiderStepNavigation"
                Grid.Row="1"
                Margin="32,0,32,12"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollMode="Disabled">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="RiderStepIdentityButton" Content="1  Identity" Tag="0" Click="RiderCreationStep_Click" AutomationProperties.AutomationId="RiderCreationStepIdentity" AutomationProperties.Name="Step 1, Identity" />
                <Button x:Name="RiderStepProfileButton" Content="2  Profile" Tag="1" Click="RiderCreationStep_Click" AutomationProperties.AutomationId="RiderCreationStepProfile" AutomationProperties.Name="Step 2, Profile" />
                <Button x:Name="RiderStepAbilitiesButton" Content="3  Abilities" Tag="2" Click="RiderCreationStep_Click" AutomationProperties.AutomationId="RiderCreationStepAbilities" AutomationProperties.Name="Step 3, Abilities" />
                <Button x:Name="RiderStepContractButton" Content="4  Contract" Tag="3" Click="RiderCreationStep_Click" AutomationProperties.AutomationId="RiderCreationStepContract" AutomationProperties.Name="Step 4, Contract" />
                <Button x:Name="RiderStepAdvancedButton" Content="5  Advanced" Tag="4" Click="RiderCreationStep_Click" AutomationProperties.AutomationId="RiderCreationStepAdvanced" AutomationProperties.Name="Step 5, Advanced" />
                <Button x:Name="RiderStepReviewButton" Content="6  Review" Tag="5" Click="RiderCreationStep_Click" AutomationProperties.AutomationId="RiderCreationStepReview" AutomationProperties.Name="Step 6, Review" />
              </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="32,0,32,12" Spacing="6">
            <InfoBar
                x:Name="RiderCreationCapabilityInfo"
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="Open a CDB to create a rider"
                Message="The wizard checks the open database schema before enabling creation."
                AutomationProperties.AutomationId="RiderCreationCapabilityStatus"
                AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="RiderLookupFeedback" Visibility="Collapsed" TextWrapping="Wrap"
                AutomationProperties.AutomationId="RiderCreationLookupStatus" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <ContentControl x:Name="RiderCreationStepContentControl" Grid.Row="3" IsEnabled="False">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="900" Margin="32,0,32,24" HorizontalAlignment="Left">
                  <Border x:Name="RiderIdentityStep" Padding="20" CornerRadius="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <StackPanel Spacing="14">
                      <TextBlock FontSize="18" FontWeight="SemiBold" Text="Identity" />
                      <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Name the rider and choose the database records that define their team, region, and rider type." />
                      <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RiderFirstNameTextBox" Header="First name" MaxLength="80" TextChanged="RiderIdentityName_TextChanged" AutomationProperties.AutomationId="RiderCreationFirstName" AutomationProperties.Name="First name" />
                        <TextBox x:Name="RiderLastNameTextBox" Grid.Column="1" Header="Last name" MaxLength="80" TextChanged="RiderIdentityName_TextChanged" AutomationProperties.AutomationId="RiderCreationLastName" AutomationProperties.Name="Last name" />
                      </Grid>
                      <AutoSuggestBox x:Name="RiderTeamSuggestBox" Header="Team" PlaceholderText="Search by team name or ID" TextChanged="RiderLookup_TextChanged" SuggestionChosen="RiderLookup_SuggestionChosen" Tag="team" AutomationProperties.AutomationId="RiderCreationTeam" AutomationProperties.Name="Team" AutomationProperties.HelpText="Searches DYN_team and shows each team name with its stored ID." />
                      <AutoSuggestBox x:Name="RiderRegionSuggestBox" Header="Region" PlaceholderText="Search by region name or ID" TextChanged="RiderLookup_TextChanged" SuggestionChosen="RiderLookup_SuggestionChosen" Tag="region" AutomationProperties.AutomationId="RiderCreationRegion" AutomationProperties.Name="Region" AutomationProperties.HelpText="Searches STA_region and shows region, country when available, and the stored ID." />
                      <AutoSuggestBox x:Name="RiderTypeSuggestBox" Header="Rider type" PlaceholderText="Search by rider type or ID" TextChanged="RiderLookup_TextChanged" SuggestionChosen="RiderLookup_SuggestionChosen" Tag="type" AutomationProperties.AutomationId="RiderCreationType" AutomationProperties.Name="Rider type" AutomationProperties.HelpText="Searches STA_type_rider and shows the rider-type name with its stored ID." />
                    </StackPanel>
                  </Border>

                  <Border x:Name="RiderProfileStep" Padding="20" CornerRadius="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                      <TextBlock FontSize="18" FontWeight="SemiBold" Text="Profile" />
                      <TextBlock x:Name="RiderProfileGuidanceText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Birth date, height, and weight are required. Height and weight use centimetres and kilograms." />
                      <CalendarDatePicker x:Name="RiderBirthDatePicker" Header="Birth date" DateChanged="RiderDraftDate_Changed" DateFormat="{}{day.integer(2)}/{month.integer(2)}/{year.full}" AutomationProperties.AutomationId="RiderCreationBirthDate" AutomationProperties.Name="Birth date" />
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="RiderHeightNumberBox" Header="Height (cm)" Minimum="1" ValueChanged="RiderDraftNumber_Changed" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="RiderCreationHeight" AutomationProperties.Name="Height in centimetres" />
                        <NumberBox x:Name="RiderWeightNumberBox" Grid.Column="1" Header="Weight (kg)" Minimum="1" ValueChanged="RiderDraftNumber_Changed" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="RiderCreationWeight" AutomationProperties.Name="Weight in kilograms" />
                      </Grid>
                      <TextBox x:Name="RiderPhotoTextBox" Header="Photo (optional)" TextChanged="RiderDraftText_Changed" PlaceholderText="For example: wdb-ridername" AutomationProperties.AutomationId="RiderCreationPhoto" AutomationProperties.Name="Photo identifier" />
                      <TextBox x:Name="RiderSoundNameTextBox" Header="Sound name (optional)" TextChanged="RiderDraftText_Changed" AutomationProperties.AutomationId="RiderCreationSoundName" AutomationProperties.Name="Sound name" />
                      <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="Favorite races (optional)" />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Search the race calendar, then add races in the order you want stored. An empty list is allowed but will be flagged on Review." />
                        <Grid ColumnSpacing="8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <AutoSuggestBox
                              x:Name="RiderFavoriteRaceSuggestBox"
                              Header="Find a race"
                              PlaceholderText="Search by race name, abbreviation, constant, or ID"
                              TextChanged="RiderFavoriteRace_TextChanged"
                              SuggestionChosen="RiderFavoriteRace_SuggestionChosen"
                              AutomationProperties.AutomationId="RiderCreationFavoriteRaceSearch"
                              AutomationProperties.Name="Find a favorite race"
                              AutomationProperties.HelpText="Searches STA_race and shows race name, country and class when available, and the stored ID." />
                          <Button
                              x:Name="AddFavoriteRaceButton"
                              Grid.Column="1"
                              VerticalAlignment="Bottom"
                              Content="Add race"
                              IsEnabled="False"
                              Click="AddFavoriteRace_Click"
                              AutomationProperties.AutomationId="AddRiderFavoriteRaceCommand"
                              AutomationProperties.Name="Add selected favorite race" />
                        </Grid>
                        <ListView
                            x:Name="RiderFavoriteRacesList"
                            SelectionMode="None"
                            MaxHeight="260"
                            AutomationProperties.AutomationId="RiderCreationFavoriteRaces"
                            AutomationProperties.Name="Selected favorite races">
                          <ListView.ItemTemplate>
                            <DataTemplate>
                              <Grid Padding="0,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="{Binding}" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Content="↑" Tag="{Binding}" Click="MoveFavoriteRaceUp_Click" AutomationProperties.AutomationId="MoveRiderFavoriteRaceUpCommand" AutomationProperties.Name="Move favorite race up" />
                                <Button Grid.Column="2" Content="↓" Tag="{Binding}" Click="MoveFavoriteRaceDown_Click" AutomationProperties.AutomationId="MoveRiderFavoriteRaceDownCommand" AutomationProperties.Name="Move favorite race down" />
                                <Button Grid.Column="3" Content="Remove" Tag="{Binding}" Click="RemoveFavoriteRace_Click" AutomationProperties.AutomationId="RemoveRiderFavoriteRaceCommand" AutomationProperties.Name="Remove favorite race" />
                              </Grid>
                            </DataTemplate>
                          </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="RiderFavoriteRaceStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="No favorite races selected." TextWrapping="Wrap" AutomationProperties.AutomationId="RiderCreationFavoriteRaceStatus" AutomationProperties.LiveSetting="Polite" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border x:Name="RiderAbilitiesStep" Padding="20" CornerRadius="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                      <TextBlock FontSize="18" FontWeight="SemiBold" Text="Abilities" />
                      <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Enter every Current value from 50 to 85. Blank Limits are NULL in the working copy and may reopen as zero after saving a CDB." />
                      <NumberBox
                          x:Name="RiderPotentialNumberBox"
                          Header="Potential"
                          Minimum="0.5"
                          Maximum="6"
                          SmallChange="0.5"
                          SpinButtonPlacementMode="Compact"
                          Value="3"
                          ValueChanged="RiderDraftNumber_Changed"
                          AutomationProperties.AutomationId="RiderCreationPotential"
                          AutomationProperties.Name="Rider potential"
                          AutomationProperties.HelpText="Stored in DYN_cyclist.value_f_potentiel. Enter a value from 0.5 to 6.0 in 0.5 increments." />
                      <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Potential is stored separately from Current abilities and Limits. The clean default is 3.0." />
                      <StackPanel Spacing="6">
                        <TextBlock x:Name="RiderCurrentAbilitySummary" TextWrapping="Wrap"
                            AutomationProperties.AutomationId="RiderCreationCurrentAbilitySummary" />
                        <CheckBox x:Name="RiderCurrentAbilityOverrideToggle" Content="Override current ability"
                            Checked="RiderCurrentAbilityMode_Changed" Unchecked="RiderCurrentAbilityMode_Changed"
                            AutomationProperties.AutomationId="RiderCreationOverrideCurrentAbility" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <NumberBox x:Name="RiderCurrentAbilityOverrideBox" Header="Current ability override" IsEnabled="False"
                              ValueChanged="RiderCurrentAbilityOverride_Changed"
                              AutomationProperties.AutomationId="RiderCreationCurrentAbilityValue" AutomationProperties.Name="Current ability override" />
                          <Button Grid.Column="1" x:Name="ResetRiderCurrentAbilityButton" Content="Use calculated value" VerticalAlignment="Bottom"
                              IsEnabled="False" Click="ResetRiderCurrentAbility_Click"
                              AutomationProperties.AutomationId="ResetRiderCurrentAbilityCommand" AutomationProperties.Name="Use calculated current ability" />
                        </Grid>
                      </StackPanel>
                      <StackPanel x:Name="RiderAbilityLimitActions" Orientation="Horizontal" Spacing="8">
                        <Button Content="Copy Current to Limits" Click="CopyRiderCurrentToLimits_Click"
                            AutomationProperties.AutomationId="CopyRiderCurrentToLimitsCommand" AutomationProperties.Name="Copy Current to Limits" />
                        <Button Content="Clear Limits" Click="ClearRiderLimits_Click"
                            AutomationProperties.AutomationId="ClearRiderLimitsCommand" AutomationProperties.Name="Clear all ability Limits" />
                      </StackPanel>
                      <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel MinWidth="620" Spacing="14">
                          <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="160" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="160" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <NumberBox x:Name="RiderBulkCurrentNumberBox" Header="Set all Current" Minimum="50" Maximum="85" ValueChanged="RiderBulkValue_Changed" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="RiderCreationBulkCurrent" AutomationProperties.Name="Value for all Current abilities" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Set Current" Click="SetAllCurrentAbilities_Click" AutomationProperties.AutomationId="SetAllRiderCurrentAbilitiesCommand" AutomationProperties.Name="Set every Current ability" />
                            <NumberBox x:Name="RiderBulkLimitNumberBox" Grid.Column="2" Header="Set all Limits" Minimum="50" Maximum="85" ValueChanged="RiderBulkValue_Changed" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="RiderCreationBulkLimit" AutomationProperties.Name="Value for all ability Limits" />
                            <Button Grid.Column="3" VerticalAlignment="Bottom" Content="Set Limits" Click="SetAllLimitAbilities_Click" AutomationProperties.AutomationId="SetAllRiderLimitAbilitiesCommand" AutomationProperties.Name="Set every ability Limit" />
                          </Grid>
                          <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="220" />
                              <ColumnDefinition Width="160" />
                              <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="Ability" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Current" />
                            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Limit (optional)" />
                          </Grid>
                          <StackPanel x:Name="RiderAbilityRowsPanel" Spacing="8" AutomationProperties.AutomationId="RiderCreationAbilityMatrix" />
                        </StackPanel>
                      </ScrollViewer>
                      <InfoBar x:Name="RiderAbilityWarningInfo" IsOpen="False" IsClosable="False" Severity="Warning" Title="Check ability combinations" AutomationProperties.AutomationId="RiderCreationAbilityWarnings" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                  </Border>

                  <Border x:Name="RiderContractStep" Padding="20" CornerRadius="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                      <TextBlock FontSize="18" FontWeight="SemiBold" Text="Contract" />
                      <TextBlock x:Name="RiderContractTeamText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="The selected team is written to the rider, current team, and previous team fields." />
                      <ComboBox x:Name="RiderRoleComboBox" Header="Role" SelectionChanged="RiderDraftRole_Changed" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RiderCreationRole" AutomationProperties.Name="Contract role" AutomationProperties.HelpText="Shows the English contract role and stored iRole code." />
                      <NumberBox x:Name="RiderWageNumberBox" Header="Wage" Minimum="1" ValueChanged="RiderDraftNumber_Changed" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="RiderCreationWage" AutomationProperties.Name="Contract wage" />
                      <NumberBox x:Name="RiderContractEndYearNumberBox" Header="Contract end year" Minimum="1" ValueChanged="RiderDraftNumber_Changed" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="RiderCreationContractEndYear" AutomationProperties.Name="Contract end year" />
                      <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Contract start is stored as 0 and the new contract is active. These values match the open save's contract model." />
                    </StackPanel>
                  </Border>

                  <Border x:Name="RiderAdvancedStep" Padding="20" CornerRadius="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                      <TextBlock FontSize="18" FontWeight="SemiBold" Text="Advanced" />
                      <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Clean defaults are ready. Expand these fields only when you need to inspect or override lower-level game data." />
                      <Expander x:Name="RiderAdvancedExpander" Header="Rider game data" IsExpanded="False">
                        <StackPanel Margin="0,12,0,0" Spacing="12">
                          <StackPanel Spacing="5">
                            <TextBlock FontWeight="SemiBold" Text="Rider display name" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="DYN_cyclist.gene_sz_firstlastname · Text" TextWrapping="Wrap" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Generated as Last name plus the first-name initial. A manual override is preserved until you reset it." TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBox x:Name="RiderGameDisplayNameTextBox" TextChanged="RiderGameDisplayName_TextChanged" AutomationProperties.AutomationId="RiderCreationGameDisplayName" AutomationProperties.Name="Rider game display name" />
                              <Button x:Name="ResetRiderGameDisplayNameButton" Grid.Column="1" VerticalAlignment="Bottom" Content="Reset to generated" Click="ResetRiderGameDisplayName_Click" AutomationProperties.AutomationId="ResetRiderGameDisplayNameCommand" AutomationProperties.Name="Reset rider display name to generated value" />
                            </Grid>
                          </StackPanel>
                          <StackPanel x:Name="RiderAdvancedFieldsPanel" Spacing="12" />
                        </StackPanel>
                      </Expander>
                      <Expander x:Name="ContractAdvancedExpander" Header="Contract game data" IsExpanded="False">
                        <StackPanel x:Name="ContractAdvancedFieldsPanel" Margin="0,12,0,0" Spacing="12" />
                      </Expander>
                    </StackPanel>
                  </Border>

                  <Border x:Name="RiderReviewStep" Padding="20" CornerRadius="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                      <TextBlock FontSize="18" FontWeight="SemiBold" Text="Review" />
                      <TextBlock x:Name="RiderReviewSummaryText" TextWrapping="Wrap" AutomationProperties.AutomationId="RiderCreationReviewSummary" />
                      <TextBlock FontWeight="SemiBold" Text="Profile" />
                      <TextBlock x:Name="RiderReviewProfileText" TextWrapping="Wrap" AutomationProperties.AutomationId="RiderCreationReviewProfile" />
                      <InfoBar x:Name="RiderReviewWarningInfo" IsOpen="False" IsClosable="False" Severity="Warning" Title="Review warnings" AutomationProperties.AutomationId="RiderCreationReviewWarnings" AutomationProperties.LiveSetting="Polite" />
                      <CheckBox x:Name="RiderMissingLimitsAcknowledgement" Visibility="Collapsed" Checked="RiderMissingLimitsAcknowledgement_Changed" Unchecked="RiderMissingLimitsAcknowledgement_Changed" AutomationProperties.AutomationId="AcknowledgeMissingRiderLimits" AutomationProperties.Name="Acknowledge blank ability limits" AutomationProperties.HelpText="Blank Limits are NULL in the working copy and may reopen as zero after saving a CDB. In-game behavior is unverified.">
                        <TextBlock TextWrapping="Wrap" Text="I understand that blank Limits are NULL in the working copy, may reopen as zero after saving, and have unverified in-game behavior." />
                      </CheckBox>
                      <TextBlock FontWeight="SemiBold" Text="Favorite races" />
                      <TextBlock x:Name="RiderReviewFavoriteRacesText" TextWrapping="Wrap" AutomationProperties.AutomationId="RiderCreationReviewFavoriteRaces" />
                      <TextBlock FontWeight="SemiBold" Text="Abilities" />
                      <TextBlock x:Name="RiderReviewAbilitiesText" TextWrapping="Wrap" />
                      <Expander Header="Complete typed insert values" IsExpanded="False">
                        <TextBox x:Name="RiderReviewTechnicalValuesTextBox" Margin="0,12,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="360" AutomationProperties.AutomationId="RiderCreationTechnicalPreview" AutomationProperties.Name="Complete typed rider and contract values" />
                      </Expander>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </ContentControl>

            <ScrollViewer x:Name="RiderCreationReceipt" Grid.Row="3" Visibility="Collapsed"
                VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="RiderCreationReceipt"
                AutomationProperties.Name="Rider creation receipt">
              <StackPanel Margin="32,12,32,24" Spacing="12" HorizontalAlignment="Left">
                <TextBlock x:Name="RiderReceiptHeading" Style="{StaticResource SectionTitleStyle}" Text="Rider and contract created" />
                <TextBlock x:Name="RiderReceiptText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="ViewCreatedRiderButton" Content="View rider" Tag="rider" Click="ViewCreatedRiderRecord_Click"
                      AutomationProperties.AutomationId="ViewCreatedRiderCommand" AutomationProperties.Name="View rider" />
                  <Button x:Name="ViewCreatedContractButton" Content="View contract" Tag="contract" Click="ViewCreatedRiderRecord_Click"
                      AutomationProperties.AutomationId="ViewCreatedContractCommand" AutomationProperties.Name="View contract" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="SaveCreatedRiderButton" Content="Save CDB" Click="SaveCreatedRider_Click"
                      AutomationProperties.AutomationId="SaveCreatedRiderCommand" AutomationProperties.Name="Save CDB" />
                  <Button x:Name="CreateAnotherRiderButton" Content="Create another" Click="CreateAnotherRider_Click"
                      AutomationProperties.AutomationId="CreateAnotherRiderCommand" AutomationProperties.Name="Create another rider" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <Border x:Name="RiderCreationFooter" Grid.Row="4" Padding="32,12" BorderBrush="{StaticResource ShellDividerBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="RiderCreationBackButton" Content="Back" Click="RiderCreationBack_Click" IsEnabled="False" AutomationProperties.AutomationId="RiderCreationBackCommand" AutomationProperties.Name="Go to previous Create Rider step" />
                <TextBlock x:Name="RiderCreationStepStatusText" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Step 1 of 6 · Identity" AutomationProperties.AutomationId="RiderCreationStepStatus" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="RiderCreationNextButton" Grid.Column="2" Content="Continue to Profile" Click="RiderCreationNext_Click" IsEnabled="False" AutomationProperties.AutomationId="RiderCreationNextCommand" AutomationProperties.Name="Continue to Profile" />
                <Button x:Name="CreateRiderButton" Grid.Column="3" Content="Create rider and contract" Click="CreateRider_Click" Visibility="Collapsed" IsEnabled="False" AutomationProperties.AutomationId="CreateRiderCommand" AutomationProperties.Name="Create rider and contract" AutomationProperties.HelpText="Recheck the preview and insert both rows atomically." />
              </Grid>
            </Border>
          </Grid>

          </ContentControl>
          <ScrollViewer x:Name="ChangesView" Visibility="Collapsed" AutomationProperties.AutomationId="SessionChangesView">
            <StackPanel MaxWidth="900" Margin="32,20" Spacing="12">
              <TextBlock Style="{StaticResource ShellTitleStyle}" Text="Changes" />
              <TextBlock Text="Recorded edits in this working session. Undo and Redo replay operations in order."
                  TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock x:Name="ChangesBaselineText" TextWrapping="Wrap"
                  AutomationProperties.AutomationId="ChangesSavedBaseline" AutomationProperties.LiveSetting="Polite" />
              <TextBlock x:Name="ChangesReplayText" TextWrapping="Wrap"
                  AutomationProperties.AutomationId="ChangesNextUndoRedo" AutomationProperties.LiveSetting="Polite" />
              <ListView x:Name="RecordedChangesList" MaxHeight="280" SelectionMode="Single"
                  SelectionChanged="RecordedChanges_SelectionChanged"
                  AutomationProperties.AutomationId="RecordedSessionOperations"
                  AutomationProperties.Name="Recorded database operations">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Padding="0,5" />
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
              <StackPanel x:Name="RecordedChangeDetails" Visibility="Collapsed" Spacing="8">
                <TextBlock x:Name="RecordedChangeRowText" TextWrapping="Wrap"
                    AutomationProperties.AutomationId="RecordedChangeRowIdentity" AutomationProperties.LiveSetting="Polite" />
                <StackPanel x:Name="RecordedChangeRowNavigation" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                  <Button x:Name="PreviousRecordedChangeRowButton" Content="Previous row"
                      Click="PreviousRecordedChangeRow_Click" AutomationProperties.AutomationId="PreviousRecordedChangeRow"
                      AutomationProperties.Name="Previous row in the recorded operation" />
                  <Button x:Name="NextRecordedChangeRowButton" Content="Next row"
                      Click="NextRecordedChangeRow_Click" AutomationProperties.AutomationId="NextRecordedChangeRow"
                      AutomationProperties.Name="Next row in the recorded operation" />
                </StackPanel>
                <TextBox x:Name="RecordedChangeValuesText" Header="Recorded field values" IsReadOnly="True"
                    AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="350"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    AutomationProperties.AutomationId="RecordedChangeFieldValues"
                    AutomationProperties.Name="Recorded field values before and after" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <Grid x:Name="RecoveryView" Visibility="Collapsed" MaxWidth="1000" Margin="32,20"
              HorizontalAlignment="Stretch" RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="8">
              <TextBlock Style="{StaticResource ShellTitleStyle}" Text="Recovery" />
              <TextBlock
                  TextWrapping="Wrap"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Text="Resume a working session to continue editing. Discard removes the selected working session and its unsaved edits. Navigating away keeps these sessions available." />
              <StackPanel x:Name="RecoveryActions" Orientation="Horizontal" Spacing="8">
                <Button x:Name="CheckRecoveryButton" Content="Refresh" Click="CheckRecovery_Click"
                    AutomationProperties.AutomationId="CheckRecoverySessionsCommand" AutomationProperties.Name="Refresh recoverable sessions"
                    AutomationProperties.HelpText="Check which working sessions can be resumed or discarded." />
                <Button x:Name="ResumeRecoveryButton" Content="Resume selected" Click="ResumeRecovery_Click" IsEnabled="False"
                    AutomationProperties.AutomationId="ResumeRecoverySessionCommand" AutomationProperties.Name="Resume selected session"
                    AutomationProperties.HelpText="Open the selected working session and keep its unsaved changes." />
                <Button x:Name="DiscardRecoveryButton" Content="Discard selected" Click="DiscardRecovery_Click" IsEnabled="False"
                    AutomationProperties.AutomationId="DiscardRecoverySessionCommand" AutomationProperties.Name="Discard selected session"
                    AutomationProperties.HelpText="Review a confirmation before removing the selected working session." />
              </StackPanel>
              <TextBlock x:Name="RecoveryStatusText" TextWrapping="Wrap" Text="Check for recoverable sessions."
                  AutomationProperties.AutomationId="RecoverySessionsStatus" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <ListView x:Name="RecoverySessionsList" Grid.Row="1" SelectionMode="Single"
                SelectionChanged="RecoverySelection_Changed" AutomationProperties.AutomationId="RecoverableSessionList"
                AutomationProperties.Name="Recoverable working sessions"
                AutomationProperties.HelpText="Each entry shows the database path and the time the working session last changed." />
            <Button x:Name="CleanCompletedSessionsButton" Grid.Row="2" HorizontalAlignment="Left" Content="Clean completed sessions"
                Click="CleanCompletedSessions_Click" AutomationProperties.AutomationId="CleanCompletedSessionsCommand"
                AutomationProperties.Name="Clean completed sessions"
                AutomationProperties.HelpText="Review a confirmation before clearing completed, clean sessions." />
          </Grid>
        </Grid>

        <Border
            Grid.Row="3"
            Padding="12,2"
            BorderBrush="{StaticResource ShellDividerBrush}"
            BorderThickness="0,1,0,0"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid ColumnSpacing="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorNeutralBrush}" />
              <TextBlock Grid.Column="1" Style="{StaticResource StatusTextStyle}" TextTrimming="CharacterEllipsis"
                  Text="{x:Bind ViewModel.Status, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
            </Grid>
            <TextBlock Grid.Column="1" Style="{StaticResource StatusTextStyle}" TextTrimming="CharacterEllipsis"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.TableSummary, Mode=OneWay}" />
            <TextBlock Grid.Column="2" Style="{StaticResource StatusTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.PageSizeLabel, Mode=OneWay}" />
            <Button Grid.Column="3" Padding="4,0" MinHeight="24" FontSize="12" Content="Save details"
                IsEnabled="{x:Bind ViewModel.HasDatabase, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.SaveDestination, Mode=OneWay}"
                AutomationProperties.AutomationId="ShowSaveDestination"
                AutomationProperties.Name="Show save destination and backup details">
              <Button.Flyout>
                <Flyout Placement="TopEdgeAlignedRight">
                  <StackPanel Width="400" Spacing="10">
                    <TextBox Text="{x:Bind ViewModel.SaveDestination, Mode=OneWay}" IsReadOnly="True"
                        TextWrapping="Wrap" Header="Save destination"
                        AutomationProperties.AutomationId="SaveDestinationPath"
                        AutomationProperties.Name="Complete save destination" />
                    <TextBox x:Name="LastSaveBackupText" IsReadOnly="True" TextWrapping="Wrap"
                        Header="Backup from the last save" AutomationProperties.AutomationId="LastSaveBackupPath"
                        AutomationProperties.Name="Backup path from the last save" />
                    <Button x:Name="OpenBackupFolderButton" Content="Open backup folder" IsEnabled="False"
                        Click="OpenBackupFolder_Click" AutomationProperties.AutomationId="OpenSaveBackupFolder"
                        AutomationProperties.Name="Open backup folder" />
                    <TextBlock Text="To inspect a backup, open it as a CDB. Use Save as to write the recovered copy to a separate path."
                        TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>
        </Border>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
