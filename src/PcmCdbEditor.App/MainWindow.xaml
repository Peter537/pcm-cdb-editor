<Window
    x:Class="PcmCdbEditor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PcmCdbEditor.App.Controls"
    xmlns:viewModels="using:PcmCdbEditor.App.ViewModels"
    Title="PCM CDB Editor">
  <Grid x:Name="WindowRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid
        x:Name="AppTitleBar"
        Grid.Row="0"
        Padding="12,0,148,0"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image Width="24" Height="24" Source="Assets/App.svg" Stretch="Uniform" />
      <TextBlock
          Grid.Column="1"
          Margin="10,0,0,0"
          VerticalAlignment="Center"
          FontFamily="Segoe UI Variable Text"
          FontSize="13"
          FontWeight="SemiBold"
          Text="PCM CDB Editor · 0.1.0 prerelease" />
      <TextBlock
          Grid.Column="2"
          VerticalAlignment="Center"
          AutomationProperties.LiveSetting="Polite"
          FontFamily="Segoe UI Variable Small"
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Text="{x:Bind ViewModel.DatabaseName, Mode=OneWay}" />
    </Grid>

    <NavigationView
        x:Name="Navigation"
        Grid.Row="1"
        AlwaysShowHeader="False"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        OpenPaneLength="216"
        CompactPaneLength="48"
        PaneDisplayMode="LeftCompact"
        SelectionChanged="Navigation_SelectionChanged"
        AutomationProperties.AutomationId="NavigationShell"
        AutomationProperties.Name="Primary navigation">
      <NavigationView.MenuItems>
        <NavigationViewItem
            x:Name="TablesNavigationItem"
            Content="Tables"
            Tag="tables"
            AutomationProperties.AutomationId="NavigationTables"
            AutomationProperties.Name="Tables">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="List" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem
            x:Name="MaintenanceNavigationItem"
            Content="Maintenance"
            Tag="maintenance"
            AutomationProperties.AutomationId="NavigationMaintenance"
            AutomationProperties.Name="Maintenance">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Repair" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem
            x:Name="RecoveryNavigationItem"
            Content="Recovery"
            Tag="recovery"
            AutomationProperties.AutomationId="NavigationRecovery"
            AutomationProperties.Name="Recovery">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Refresh" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <Grid x:Name="Workspace" SizeChanged="Workspace_SizeChanged">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <CommandBar
            x:Name="WorkspaceCommandBar"
            Grid.Row="0"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="True"
            Background="Transparent"
            AutomationProperties.AutomationId="WorkspaceCommandBar"
            AutomationProperties.Name="Database commands">
          <AppBarButton x:Name="OpenButton" Icon="OpenFile" Label="Open" Click="Open_Click" AutomationProperties.AutomationId="OpenDatabaseCommand" AutomationProperties.Name="Open database" AutomationProperties.HelpText="Open a CDB file from a safe working copy. Shortcut Ctrl+O.">
            <AppBarButton.KeyboardAccelerators>
              <KeyboardAccelerator Key="O" Modifiers="Control" />
            </AppBarButton.KeyboardAccelerators>
          </AppBarButton>
          <AppBarButton x:Name="SaveButton" Icon="Save" Label="Save" Click="Save_Click" IsEnabled="{x:Bind ViewModel.IsDatabaseOpen, Mode=OneWay}" AutomationProperties.AutomationId="SaveDatabaseCommand" AutomationProperties.Name="Save database" AutomationProperties.HelpText="Convert and atomically replace the current destination. Shortcut Ctrl+S.">
            <AppBarButton.KeyboardAccelerators>
              <KeyboardAccelerator Key="S" Modifiers="Control" />
            </AppBarButton.KeyboardAccelerators>
          </AppBarButton>
          <AppBarButton x:Name="SaveAsButton" Icon="SaveLocal" Label="Save as" Click="SaveAs_Click" IsEnabled="{x:Bind ViewModel.IsDatabaseOpen, Mode=OneWay}" AutomationProperties.AutomationId="SaveDatabaseAsCommand" AutomationProperties.Name="Save database as" AutomationProperties.HelpText="Save the isolated working database to a different CDB destination." />
          <AppBarButton
              x:Name="CancelOperationButton"
              Icon="Cancel"
              Label="Cancel"
              Click="CancelOperation_Click"
              Visibility="Collapsed"
              AutomationProperties.AutomationId="CancelOperationCommand"
              AutomationProperties.Name="Cancel current operation"
              AutomationProperties.HelpText="Cancel the current open, save, table load, or maintenance operation." />
          <AppBarSeparator />
          <AppBarButton x:Name="UndoButton" Icon="Undo" Label="Undo" Click="Undo_Click" IsEnabled="False" AutomationProperties.AutomationId="UndoEditCommand" AutomationProperties.Name="Undo last edit" AutomationProperties.HelpText="Undo the last database edit. Shortcut Ctrl+Z.">
            <AppBarButton.KeyboardAccelerators>
              <KeyboardAccelerator Key="Z" Modifiers="Control" />
            </AppBarButton.KeyboardAccelerators>
          </AppBarButton>
          <AppBarButton x:Name="RedoButton" Icon="Redo" Label="Redo" Click="Redo_Click" IsEnabled="False" AutomationProperties.AutomationId="RedoEditCommand" AutomationProperties.Name="Redo last undone edit" AutomationProperties.HelpText="Redo the last undone database edit. Shortcut Ctrl+Y.">
            <AppBarButton.KeyboardAccelerators>
              <KeyboardAccelerator Key="Y" Modifiers="Control" />
            </AppBarButton.KeyboardAccelerators>
          </AppBarButton>
          <CommandBar.SecondaryCommands>
            <AppBarToggleButton x:Name="RowInspectorToggle" Icon="View" Label="Row inspector" IsChecked="{x:Bind ViewModel.IsInspectorOpen, Mode=TwoWay}" Click="RowInspectorToggle_Click" AutomationProperties.AutomationId="ToggleRowInspectorCommand" AutomationProperties.Name="Show row inspector" AutomationProperties.HelpText="Show or hide the typed values for the selected row." />
            <AppBarButton x:Name="OverflowInsertRowButton" Icon="Add" Label="Insert row" Click="InsertRow_Click" IsEnabled="False" AutomationProperties.AutomationId="OverflowInsertTableRowCommand" AutomationProperties.Name="Insert row" AutomationProperties.HelpText="Create a new typed row in the current table." />
            <AppBarButton x:Name="OverflowEditRowButton" Icon="Edit" Label="Edit row" Click="EditRow_Click" IsEnabled="False" AutomationProperties.AutomationId="OverflowEditSelectedRowCommand" AutomationProperties.Name="Edit row" AutomationProperties.HelpText="Edit typed values in the selected row." />
            <AppBarButton x:Name="OverflowDeleteRowButton" Icon="Delete" Label="Delete row" Click="DeleteRow_Click" IsEnabled="False" AutomationProperties.AutomationId="OverflowDeleteSelectedRowCommand" AutomationProperties.Name="Delete row" AutomationProperties.HelpText="Preview deletion of the selected row before confirmation." />
            <AppBarSeparator />
            <AppBarButton x:Name="DensityButton" Icon="Setting" Label="Density" Click="Density_Click" AutomationProperties.AutomationId="ChangeDensityCommand" AutomationProperties.Name="Change table density" AutomationProperties.HelpText="Choose compact or comfortable table density." />
            <AppBarButton x:Name="KeyboardShortcutsButton" Icon="Help" Label="Keyboard shortcuts" Click="KeyboardShortcuts_Click" AutomationProperties.AutomationId="ShowKeyboardShortcutsCommand" AutomationProperties.Name="Show keyboard shortcuts" />
          </CommandBar.SecondaryCommands>
        </CommandBar>

        <InfoBar
            x:Name="OperationInfo"
            Grid.Row="1"
            Margin="12,0,12,8"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational"
            AutomationProperties.AutomationId="OperationStatusMessage"
            AutomationProperties.Name="Operation status"
            AutomationProperties.LiveSetting="Polite" />

        <Grid x:Name="ContentHost" Grid.Row="2">
          <Grid x:Name="TablesView">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="InspectorColumn" Width="300" />
          </Grid.ColumnDefinitions>

          <Border
              Grid.Column="0"
              Padding="12"
              BorderBrush="{StaticResource ShellDividerBrush}"
              BorderThickness="0,0,1,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Tables" />
              <AutoSuggestBox
                  x:Name="TableSearchBox"
                  Grid.Row="1"
                  Margin="0,8,0,8"
                  Height="32"
                  QueryIcon="Find"
                  PlaceholderText="Find a table"
                  TextChanged="TableSearchBox_TextChanged"
                  AutomationProperties.AutomationId="TableCatalogSearch"
                  AutomationProperties.Name="Find a table" />
              <Grid Grid.Row="2">
                <ListView
                    x:Name="TablesList"
                    ItemsSource="{x:Bind ViewModel.Tables, Mode=OneWay}"
                    SelectionChanged="TablesList_SelectionChanged"
                    SelectionMode="Single"
                    AutomationProperties.AutomationId="TableCatalogList"
                    AutomationProperties.Name="Database tables">
                  <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:TableListItem">
                      <Grid Padding="2,5" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind KindLabel}" />
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <StackPanel
                    x:Name="NoTablesState"
                    VerticalAlignment="Top"
                    Margin="4,8,4,0"
                    Spacing="4"
                    AutomationProperties.AutomationId="NoTablesState"
                    AutomationProperties.Name="No tables loaded">
                  <TextBlock x:Name="NoTablesTitle" Text="No tables loaded" />
                  <TextBlock
                      x:Name="NoTablesDescription"
                      FontSize="12"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Text="Open a CDB file first."
                      TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <Grid Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TabView
                x:Name="TableTabs"
                Grid.Row="0"
                Height="42"
                IsAddTabButtonVisible="False"
                SelectionChanged="TableTabs_SelectionChanged"
                TabCloseRequested="TableTabs_TabCloseRequested"
                AutomationProperties.AutomationId="OpenTableTabs"
                AutomationProperties.Name="Open table tabs" />
            <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <AutoSuggestBox
                  x:Name="CurrentTableSearchBox"
                  Height="32"
                  QueryIcon="Find"
                  PlaceholderText="Search the current table"
                  TextChanged="CurrentTableSearchBox_TextChanged"
                  AutomationProperties.AutomationId="CurrentTableSearch"
                  AutomationProperties.Name="Search the current table" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button x:Name="FiltersButton" Height="32" Content="Filters" Click="Filters_Click" AutomationProperties.AutomationId="ConfigureTableFiltersCommand" AutomationProperties.Name="Filters" AutomationProperties.HelpText="Build quick rules and numbered advanced filter rules for the current table." />
                <Button x:Name="SortButton" Height="32" Content="Sort" Click="Sort_Click" AutomationProperties.AutomationId="ConfigureTableSortCommand" AutomationProperties.Name="Sort" AutomationProperties.HelpText="Order the current table by one or more columns." />
              </StackPanel>
              <ComboBox x:Name="PageSizeBox" Grid.Column="2" Width="120" Height="32" SelectedIndex="0" SelectionChanged="PageSizeBox_SelectionChanged" AutomationProperties.AutomationId="TablePageSize" AutomationProperties.Name="Page size" AutomationProperties.HelpText="Choose how many table rows appear on each page.">
                <ComboBoxItem Content="100 rows" />
                <ComboBoxItem Content="250 rows" />
              </ComboBox>
              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                <Button x:Name="PreviousPageButton" Width="34" Height="32" Click="PreviousPage_Click" IsEnabled="False" ToolTipService.ToolTip="Previous page" AutomationProperties.AutomationId="PreviousTablePageCommand" AutomationProperties.Name="Previous page" AutomationProperties.HelpText="Show the previous page of rows in the current table.">
                  <SymbolIcon Symbol="Previous" />
                </Button>
                <Button x:Name="NextPageButton" Width="34" Height="32" Click="NextPage_Click" IsEnabled="False" ToolTipService.ToolTip="Next page" AutomationProperties.AutomationId="NextTablePageCommand" AutomationProperties.Name="Next page" AutomationProperties.HelpText="Show the next page of rows in the current table.">
                  <SymbolIcon Symbol="Next" />
                </Button>
              </StackPanel>
            </Grid>
            <Grid Grid.Row="2">
              <controls:TableGridAdapterControl
                  x:Name="TableGrid"
                  Opacity="0"
                  IsEnabled="False"
                  IsHitTestVisible="False"
                  AutomationProperties.AutomationId="CurrentTableGrid"
                  AutomationProperties.Name="Current table data"
                  AutomationProperties.AccessibilityView="Raw" />
              <StackPanel
                  x:Name="TableLoadingState"
                  Width="420"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="10"
                  Visibility="Collapsed"
                  AutomationProperties.AutomationId="TableLoadingState"
                  AutomationProperties.Name="Table loading"
                  AutomationProperties.HelpText="The requested table is loading. Cancel returns to the previous completed table.">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="28"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                    Glyph="&#xE895;"
                    AutomationProperties.AccessibilityView="Raw" />
                <TextBlock
                    x:Name="TableLoadingTitle"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SectionTitleStyle}"
                    Text="Loading table…"
                    AutomationProperties.AutomationId="TableLoadingAnnouncement"
                    AutomationProperties.LiveSetting="Polite" />
                <TextBlock
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="The previous completed table remains available if you cancel." />
              </StackPanel>
              <StackPanel
                  x:Name="EmptyState"
                  Width="420"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="12"
                  AutomationProperties.AutomationId="NoDatabaseOpenState"
                  AutomationProperties.Name="No database open">
                <Image Width="72" Height="72" Source="Assets/App.svg" Stretch="Uniform" />
                <TextBlock
                    x:Name="EmptyStateTitle"
                    HorizontalAlignment="Center"
                    Style="{StaticResource ShellTitleStyle}"
                    Text="Open a CDB file" />
                <TextBlock
                    x:Name="EmptyStateDescription"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="The original stays untouched while you inspect and edit an isolated working copy." />
                <Button
                    x:Name="EmptyStateOpenButton"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Open_Click"
                    Content="Choose a CDB file"
                    AutomationProperties.AutomationId="EmptyStateOpenDatabaseCommand"
                    AutomationProperties.Name="Choose a CDB file"
                    AutomationProperties.HelpText="Open a CDB file in an isolated working session." />
                <TextBlock
                    x:Name="EmptyStateReleaseLabel"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="Unreleased 0.1.0 · Unsigned prerelease" />
              </StackPanel>
              <FontIcon
                  x:Name="BusyIndicator"
                  Width="36"
                  Height="36"
                  FontSize="28"
                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                  Glyph="&#xE895;"
                  Visibility="Collapsed"
                  AutomationProperties.AutomationId="DatabaseOperationBusyState"
                  AutomationProperties.Name="Database operation in progress" />
            </Grid>
          </Grid>

          <Border
              x:Name="Inspector"
              Grid.Column="2"
              Padding="16,12"
              BorderBrush="{StaticResource ShellDividerBrush}"
              BorderThickness="1,0,0,0">
            <ScrollViewer>
              <StackPanel Spacing="12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Row inspector" />
                  <Button x:Name="CloseInspectorButton" Grid.Column="1" Width="32" Height="32" Click="CloseInspector_Click" ToolTipService.ToolTip="Close inspector" AutomationProperties.AutomationId="CloseRowInspectorCommand" AutomationProperties.Name="Close row inspector">
                    <SymbolIcon Symbol="Cancel" />
                  </Button>
                </Grid>
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Select a row to inspect typed values. BLOB values are shown as read-only metadata." />
                <Border Height="1" Background="{StaticResource ShellDividerBrush}" />
                <TextBlock x:Name="InspectorHeading" FontWeight="SemiBold" Text="No row selected" AutomationProperties.AutomationId="RowInspectorHeading" />
                <ListView x:Name="InspectorValues" SelectionMode="None" AutomationProperties.AutomationId="RowInspectorValues" AutomationProperties.Name="Selected row values">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="120" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding ColumnName}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding DisplayValue}"
                            TextWrapping="WrapWholeWords" />
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="RowActions" Orientation="Horizontal" Spacing="8">
                  <Button x:Name="EditRowButton" Content="Edit row" Click="EditRow_Click" IsEnabled="False" AutomationProperties.AutomationId="EditSelectedRowCommand" AutomationProperties.Name="Edit row" AutomationProperties.HelpText="Edit typed values in the selected row." />
                  <Button x:Name="DeleteRowButton" Content="Delete row" Click="DeleteRow_Click" IsEnabled="False" AutomationProperties.AutomationId="DeleteSelectedRowCommand" AutomationProperties.Name="Delete row" AutomationProperties.HelpText="Preview deletion of the selected row before confirmation." />
                  <Button x:Name="InsertRowButton" Content="Insert row" Click="InsertRow_Click" IsEnabled="False" AutomationProperties.AutomationId="InsertTableRowCommand" AutomationProperties.Name="Insert row" AutomationProperties.HelpText="Create a new typed row in the current table." />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
          </Grid>

          <ScrollViewer x:Name="MaintenanceView" Visibility="Collapsed">
            <StackPanel MaxWidth="880" Margin="32,20" HorizontalAlignment="Left" Spacing="16">
              <TextBlock Style="{StaticResource ShellTitleStyle}" Text="Maintenance" />
              <TextBlock
                  MaxWidth="720"
                  TextWrapping="Wrap"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Text="Each tool checks the open database first and shows what will change. Nothing changes until you select Apply." />
              <Border Padding="16" CornerRadius="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <StackPanel Spacing="10">
                  <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Rider recovery preset" />
                  <TextBlock TextWrapping="Wrap" Text="Set Fit 99, Injury 0, Injury days 0, Physical fatigue 0, Freshness 100, and Preparation 99 for selected cyclist IDs." />
                  <TextBox
                      x:Name="RiderIdsTextBox"
                      Header="Cyclist IDs from selected table rows"
                      PlaceholderText="Select rows containing IDcyclist or fkIDcyclist"
                      IsReadOnly="True"
                      AutomationProperties.AutomationId="SelectedRiderIds"
                      AutomationProperties.Name="Cyclist IDs from selected table rows"
                      AutomationProperties.HelpText="Select one or more rows containing IDcyclist or fkIDcyclist in the table grid." />
                  <Button
                      x:Name="PreviewRiderRecoveryButton"
                      HorizontalAlignment="Left"
                      Content="Check and preview"
                      Click="PreviewRiderRecovery_Click"
                      AutomationProperties.AutomationId="PreviewRiderRecoveryCommand"
                      AutomationProperties.Name="Check and preview rider recovery"
                      AutomationProperties.HelpText="Check rider recovery requirements and preview changes without modifying the database." />
                </StackPanel>
              </Border>
              <Border Padding="16" CornerRadius="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <StackPanel Spacing="10">
                  <TextBlock Style="{StaticResource SectionTitleStyle}" Text="January 1 season-stage repair" />
                  <TextBlock TextWrapping="Wrap" Text="Preview the January 1 season-stage repair and the number of rows it will delete before applying it." />
                  <Button
                      x:Name="PreviewJanuaryRepairButton"
                      HorizontalAlignment="Left"
                      Content="Check and preview"
                      Click="PreviewJanuaryRepair_Click"
                      AutomationProperties.AutomationId="PreviewJanuaryRepairCommand"
                      AutomationProperties.Name="Check and preview January 1 season-stage repair"
                      AutomationProperties.HelpText="Check January 1 repair requirements and preview affected rows without modifying the database." />
                </StackPanel>
              </Border>
              <Border Padding="16" CornerRadius="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <StackPanel Spacing="10">
                  <TextBlock Style="{StaticResource SectionTitleStyle}" Text="World and European country quotas" />
                  <TextBlock TextWrapping="Wrap" Text="Preview the combined World Championship and European Championship quota update, including canonical country codes and ranks." />
                  <Button
                      x:Name="PreviewCountryQuotasButton"
                      HorizontalAlignment="Left"
                      Content="Check and preview"
                      Click="PreviewCountryQuotas_Click"
                      AutomationProperties.AutomationId="PreviewCountryQuotasCommand"
                      AutomationProperties.Name="Check and preview World and European country quotas"
                      AutomationProperties.HelpText="Check championship quota requirements and preview all changes without modifying the database." />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="RecoveryView" Visibility="Collapsed">
            <StackPanel MaxWidth="760" Margin="32,20" HorizontalAlignment="Left" Spacing="12">
              <TextBlock Style="{StaticResource ShellTitleStyle}" Text="Recovery" />
              <TextBlock
                  TextWrapping="Wrap"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Text="At startup, the app lists working sessions that can be recovered. Choose Not now to leave them available for the next launch." />
              <Button x:Name="CheckRecoveryButton" HorizontalAlignment="Left" Content="Check for recoverable sessions" Click="CheckRecovery_Click" AutomationProperties.AutomationId="CheckRecoverySessionsCommand" AutomationProperties.Name="Check for recoverable sessions" AutomationProperties.HelpText="List working sessions that can be resumed or discarded." />
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <Border
            Grid.Row="3"
            Padding="12,0"
            BorderBrush="{StaticResource ShellDividerBrush}"
            BorderThickness="0,1,0,0"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorNeutralBrush}" />
              <TextBlock Style="{StaticResource StatusTextStyle}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <TextBlock Grid.Column="1" Style="{StaticResource StatusTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.TableSummary, Mode=OneWay}" />
            <TextBlock Grid.Column="2" Style="{StaticResource StatusTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.PageSizeLabel, Mode=OneWay}" />
            <TextBlock Grid.Column="3" Style="{StaticResource StatusTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Copy-first session" />
          </Grid>
        </Border>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
